# ============================================================================
# tkt CLI — Multi-Provider Credentials (.env)
# ============================================================================
# Never commit your real .env file. Board profiles and non-secret schema
# settings live in .tkt/config.json (created via `tkt setup`).

# --- Active Default Profile (optional override) ---
# TKT_DEFAULT_PROFILE=jira-main

# --- Jira Cloud / Jira Data Center Credentials ---
JIRA_URL=https://your-org.atlassian.net
JIRA_USER=you@example.com
JIRA_TOKEN=ATATT3xFfGF0...
# Optional: "cloud" (Basic auth email:token) or "datacenter" (Bearer PAT)
JIRA_AUTH_TYPE=cloud

# --- Azure DevOps (ADO) Credentials ---
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_TOKEN=your_personal_access_token_here
# Optional: user email for display/filtering
ADO_USER=you@example.com
