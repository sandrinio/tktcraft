{
  "tkt-board-governance": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/tkt-hook.cjs pre-tool",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/tkt-hook.cjs post-tool",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
